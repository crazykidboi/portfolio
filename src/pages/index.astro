---
import H1 from "../components/h1.astro";
import Link from "../components/link.astro";
import Navigation from "../components/navigation";
import RootLayout from "../layouts/RootLayout.astro";
import WarpBackground from "../components/warp-background";
import AvailableForWork from "../components/available.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

// Fetch, filter, sort, and grab the top 8 most recent articles
const recentArticles = (await getCollection("articles"))
    .filter(article => !article.data.isDraft)
    .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
    .slice(0, 8);
---

<RootLayout>
<!-- background -->
    <div class="fixed -top-[10vh] left-0 w-full h-[120vh]">
            <WarpBackground
                color1="#111111"
                color2="#222222"
                color3="#852d1f"
                speed={0.2}
                swirl={0.8}
                swirlIterations={10}
                shapeScale={0.3}
                client:load
            />
            <!-- Overlay that receives the dynamic blur -->
            <div id="blur-overlay" class="absolute inset-0 pointer-events-none"></div>
        </div>

    <main class="parallax-container bg-black" id="scroll-container">
        


        <div class="parallax-content relative z-10">
            
            <div class="relative w-full h-dvh flex flex-col justify-between p-4 md:p-10">
                <H1 size="large">Liam Lyons IV<br />Portfolio</H1>

                <div class="pb-14 p-3 flex items-center justify-center">
                    <Link href="/work">Collection</Link>
                </div>

                <div class="absolute bottom-6 left-1/2 -translate-x-1/2 animate-bounce text-zinc-400">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                    </svg>
                </div>
            </div>

            <div class="w-full min-h-dvh p-4 md:p-10 pt-20">
                
                <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-10">
                    {recentArticles.map((article) => (
                        <a href={`/work/${article.id}`} class="group relative aspect-[3/4] rounded-s border border-zinc-900 overflow-hidden block bg-zinc-900 active:scale-[0.98] transition-transform duration-150">
                            
                            <Image 
                                src={article.data.cover} 
                                alt={article.data.title}
                                width={600}
                                height={800}
                                quality="low"
                                format="webp"
                                class="absolute inset-0 w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-40"
                            />
                            
                            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-transparent"></div>
                            
                            <!-- Text Content with Large, Sharp Animated Vector Backdrop -->
                            <div class="absolute bottom-0 left-0 p-6 md:p-8 w-full z-10">
                                
                                <!-- Vector Blob -->
                                <svg viewBox="0 0 290 60" xmlns="http://www.w3.org/2000/svg" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[250%] h-[250%] -z-10 pointer-events-none blob-warp group-active:brightness-110 transition-all duration-250">
                                    <path fill="#111111" opacity="0.8" d="M -85,0 A 85,85 0 0,1 85,0 Z" transform="translate(100 100)" />
                                </svg>

                                <div class="relative z-10">
                                    <p class="text-zinc-200 text-sm md:text-xs sm:text-xs mb-2 uppercase tracking-wider italic">
                                        {article.data.category}
                                    </p>
                                    <h2 class="text-xl font-bold text-white group-hover:underline underline-offset-2 decoration-transparent group-hover:decoration-zinc-300">
                                        {article.data.title}
                                    </h2>
                                </div>
                            </div>
                        </a>
                    ))}
                </div>

                <div class="pb-8">
                    <AvailableForWork className="py-10 justify-center" />
                    
                    <div class="mb-2 sm:mb-4 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-4">
                            <Link href="/work?category=lighting%20design" variant="secondary">Lighting Design</Link>
                            <Link href="/work?category=touring" variant="secondary">Touring</Link>
                            <Link href="/work?category=videography" variant="secondary">Videography</Link>
                            <Link href="/work?category=photography" variant="secondary">Photography</Link>
                        </div>

                        <Navigation client:load>
                            <Link href="/about" variant="secondary">About</Link>
                            <Link href="/contact" variant="secondary">Contact</Link>
                        </Navigation>
                    </div>
                </div>

            </div>
        </div>
    </main>
</RootLayout>

<style>
    .parallax-container {
        height: 100vh;
        overflow-y: auto;
        overflow-x: hidden;
        perspective: 10px; 
    }

    .parallax-bg {
        transform: translateZ(-10px) scale(2);
        transform-origin: center center;
        pointer-events: none; 
    }

    .parallax-content {
        transform: translateZ(-0/5px); 
    }
</style>

<script>
    // Controls the background blur based on scroll position
    const container = document.getElementById('scroll-container');
    const overlay = document.getElementById('blur-overlay');

    if (container && overlay) {
        container.addEventListener('scroll', () => {
            // Divides scroll distance by 40 to control how fast the blur applies.
            // Caps the maximum blur at 12px so it doesn't get completely washed out.
            const blurAmount = Math.min(container.scrollTop / 40, 12);
            overlay.style.backdropFilter = `blur(${blurAmount}px)`;
            overlay.style.webkitBackdropFilter = `blur(${blurAmount}px)`;
        });
    }
</script>

